{
  "configVersion": "v3",
  "app": {
    "appId": 1000001,
    "appName": "AEVUM",
    "appType": "app",
    "version": { "code": 1, "name": "1.0.0" },
    "icon": "icon.png",
    "vender": "aevum",
    "description": "Sync your health data to AEVUM"
  },
  "permissions": [
    "data:os.device.info",
    "data:user.hd.step",
    "data:user.hd.calorie",
    "data:user.hd.distance",
    "data:user.hd.heart_rate",
    "data:user.hd.spo2",
    "data:user.hd.stress",
    "data:user.hd.sleep",
    "data:user.hd.pai"
  ],
  "runtime": {
    "apiVersion": { "compatible": "3.0", "target": "3.0", "minVersion": "3.0" }
  },
  "debug": false,
  "targets": {
    "common": {
      "module": {
        "page": { "pages": ["page/home/index.page"] },
        "app-side": { "path": "app-side/index" },
        "setting": { "path": "setting/index" }
      },
      "platforms": [{ "st": "s" }, { "st": "r" }],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": { "appName": "AEVUM" },
    "el-GR": { "appName": "AEVUM" }
  },
  "defaultLanguage": "en-US"
}
