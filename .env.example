# Domain the app is served on (docker-compose + Caddy only)
DOMAIN=aevum.example.com

# Server
PORT=8787
# Public HTTPS URL of this deployment (used in pairing instructions and the watch app)
PUBLIC_URL=http://localhost:8787
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# SQLite file location
DATABASE_PATH=./data/aevum.db

# AI — pick ONE (or none):
#
# 1) Free: Google Gemini free tier. Create a key at https://aistudio.google.com/apikey with a Google account,
#    no card needed. Free-tier requests may be used by Google to improve its products.
GEMINI_API_KEY=
#
# 2) Free, any other OpenAI-compatible endpoint (overrides the Gemini default URL), e.g.
#    Groq:        AI_BASE_URL=https://api.groq.com/openai/v1   AI_API_KEY=...  AI_MODEL=llama-3.3-70b-versatile
#    OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1     AI_API_KEY=...  AI_MODEL=<a ":free" model>
#    Ollama:      AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=qwen2.5:7b   (runs on your own computer)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
#
# 3) Paid: Anthropic Claude API (takes precedence when set).
ANTHROPIC_API_KEY=
AEVUM_AI_MODEL=claude-opus-5-5
AEVUM_AI_EFFORT=medium
#
# With none of these, everything still works without AI: biological age from validated formulas,
# rule-based daily insights, and lab reports read on the phone (PDF text / OCR).

# Video calls for 1-1 sessions. Each session gets a room under this base URL.
# meet.jit.si works for testing; for production use a self-hosted Jitsi or JaaS (8x8) domain.
VIDEO_BASE_URL=https://meet.jit.si

# Time zone of experts' weekly availability
CLINIC_TIME_ZONE=Europe/Athens

# Native app: server address pre-filled on the login screen (set at build time)
VITE_DEFAULT_SERVER=
