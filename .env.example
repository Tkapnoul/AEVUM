# Domain the app is served on (docker-compose + Caddy only)
DOMAIN=aevum.example.com

# Server
PORT=8787
# Public HTTPS URL of this deployment (used in pairing instructions and the watch app)
PUBLIC_URL=http://localhost:8787
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# SQLite file location
DATABASE_PATH=./data/aevum.db

# AI (Claude). Without a key the AI features show "not configured" instead of answers.
ANTHROPIC_API_KEY=
AEVUM_AI_MODEL=claude-opus-5-5
AEVUM_AI_EFFORT=medium

# Video calls for 1-1 sessions. Each session gets a room under this base URL.
# meet.jit.si works for testing; for production use a self-hosted Jitsi or JaaS (8x8) domain.
VIDEO_BASE_URL=https://meet.jit.si

# Time zone of experts' weekly availability
CLINIC_TIME_ZONE=Europe/Athens

# Native app: server address pre-filled on the login screen (set at build time)
VITE_DEFAULT_SERVER=
